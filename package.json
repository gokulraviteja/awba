{
  "name": "awba",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -k -n api,web -c cyan,green \"npm:api\" \"npm:dev\"",
    "dev:all": "concurrently -k -n api,web,mcp -c cyan,green,magenta \"npm:api\" \"npm:dev\" \"npm:mcp:dev\"",
    "api": "go -C ../awba-backend run ./cmd/api",
    "ingest": "go -C ../awba-backend run ./cmd/ingest",
    "mcp:dev": "npm --prefix apps/mcp run dev",
    "mcp:build": "npm --prefix apps/mcp run build",
    "test:mcp": "npm --prefix apps/mcp run test",
    "test:e2e": "playwright test",
    "build": "vite build",
    "preview": "vite preview",
    "test:backend": "go -C ../awba-backend test ./...",
    "check": "npm run test:backend && npm run test:mcp && npm run mcp:build && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.4",
    "vite": "^5.4.21"
  }
}
